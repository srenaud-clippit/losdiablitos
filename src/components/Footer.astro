---
import { site } from '../data/site';
import { rel } from '../lib/url';

const R = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col">
      <img src={rel(R, site.logo)} alt="Los Diablitos" class="footer-logo" width="150" height="64" />
      <p>Association de danse Salsa, Bachata et Kizomba (SBK) sur le secteur de Thoiry (Yvelines).</p>
    </div>

    <div class="footer-col">
      <h4>Mentions légales</h4>
      <p>Association de danse Salsa, Bachata et Kizomba (SBK)</p>
      <p>Editeur du Site : ASSOCIATION LOS DIABLITOS</p>
      <p>Responsable éditorial : Jean-François Bernard (Président de l'Association)</p>
    </div>

    <div class="footer-col">
      <h4>Liens</h4>
      <ul>
        <li><a href={rel(R, site.reglement)} target="_blank" rel="noopener">Règlement Intérieur</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© 2021 Association danse Los Diablitos</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: rgba(255, 255, 255, 0.75);
    padding-top: 56px;
    font-size: 0.95rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer-logo {
    height: 60px;
    width: auto;
    margin-bottom: 16px;
  }

  .footer-col h4 {
    color: #fff;
    font-size: 1.05rem;
    margin: 0 0 16px;
    letter-spacing: 0.5px;
  }

  .footer-col p {
    margin: 0 0 8px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: 10px;
  }

  /* Liens sur fond sombre : déclinaison claire du rouge. */
  .footer-col a {
    color: var(--color-primary-on-dark);
  }

  .footer-col a:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    padding: 22px 0;
    font-size: 0.88rem;
  }

  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      text-align: center;
    }
    .footer-logo {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
