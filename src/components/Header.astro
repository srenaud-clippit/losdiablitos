---
import { nav, site } from '../data/site';
import { rel } from '../lib/url';

interface Props {
  /** Accueil : barre transparente sur la vidéo, et logo masqué tant qu'on n'a
   *  pas défilé (le grand logo est déjà au centre du hero). */
  transparent?: boolean;
}
const { transparent = false } = Astro.props;
const R = Astro.url.pathname;
const current = R;
---

<header class:list={['site-header', { transparent }]}>
  <div class="header-inner container">
    <div class="header-left">
      <button
        class="nav-toggle"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <span></span><span></span><span></span>
      </button>

      <a
        href={rel(R, '/')}
        class:list={['logo', { 'logo-hidden-at-top': transparent }]}
        aria-label="Los Diablitos — Accueil"
      >
        <img src={rel(R, site.logo)} alt="Los Diablitos" width="150" height="64" />
      </a>
    </div>
  </div>
</header>

<div class="nav-backdrop" hidden></div>

<nav id="site-nav" class="site-nav" aria-label="Menu principal">
  <ul>
    {
      nav.map((item) => (
        <li>
          <a href={rel(R, item.href)} class:list={[{ active: current === item.href }]}>
            {item.label}
          </a>
        </li>
      ))
    }
    <li class="nav-sep">
      <a href={site.facebook} target="_blank" rel="noopener" class="fb">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.79 8.43-4.94 8.43-9.94Z" />
        </svg>
        Facebook
      </a>
    </li>
  </ul>
</nav>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-dark);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.15);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.transparent {
    background: transparent;
    box-shadow: none;
  }

  .site-header.transparent.scrolled {
    background: var(--color-dark);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.25);
  }

  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
  }

  /* Hamburger à gauche, logo juste à sa droite. */
  .header-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .logo img {
    height: 56px;
    width: auto;
  }

  /* Accueil : le logo n'apparaît qu'une fois défilé (grand logo dans le hero). */
  .logo-hidden-at-top {
    opacity: 0;
    visibility: hidden;
    transform: translateX(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }

  .site-header.scrolled .logo-hidden-at-top {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 9px 8px;
    flex: none;
  }

  .nav-toggle span {
    display: block;
    height: 3px;
    width: 100%;
    background: #fff;
    border-radius: 2px;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.4));
    transition: transform 0.3s ease, opacity 0.2s ease;
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-primary-on-dark);
    outline-offset: 3px;
    border-radius: 6px;
  }

  /* Panneau latéral */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: 320px;
    max-width: 84vw;
    height: 100%;
    background: var(--color-dark);
    padding-top: calc(var(--header-height) + 12px);
    transform: translateX(-100%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }

  .site-nav.open {
    transform: translateX(0);
    box-shadow: 6px 0 28px rgba(0, 0, 0, 0.4);
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 12px 20px 32px;
  }

  .site-nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 1.08rem;
    font-weight: 500;
    padding: 15px 12px;
    border-radius: 8px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: color 0.2s ease, background 0.2s ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible,
  .site-nav a.active {
    color: var(--color-primary-on-dark);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-sep {
    margin-top: 14px;
  }

  .nav-sep a {
    border-bottom: none;
    font-size: 0.98rem;
  }

  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nav-backdrop.visible {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .nav-backdrop,
    .logo-hidden-at-top {
      transition: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.querySelector<HTMLElement>('#site-nav');
  const backdrop = document.querySelector<HTMLElement>('.nav-backdrop');

  if (toggle && panel && backdrop) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      document.body.classList.toggle('nav-open', open);

      if (open) {
        backdrop.hidden = false;
        requestAnimationFrame(() => backdrop.classList.add('visible'));
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        backdrop.classList.remove('visible');
        setTimeout(() => {
          if (!panel.classList.contains('open')) backdrop.hidden = true;
        }, 300);
      }
    };

    toggle.addEventListener('click', () => setOpen(!panel.classList.contains('open')));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // Accueil : barre opaque + logo visible une fois défilé.
  if (header?.classList.contains('transparent')) {
    const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 60);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
