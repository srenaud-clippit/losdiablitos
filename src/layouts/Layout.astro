---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { rel } from '../lib/url';

const R = Astro.url.pathname;

interface Props {
  title: string;
  description?: string;
  transparentHeader?: boolean;
}

const {
  title,
  description = "Los Diablitos, association de danse latine (Salsa, Bachata, Kizomba) sur le secteur de Thoiry dans les Yvelines.",
  transparentHeader = false,
} = Astro.props;

const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={rel(R, '/uploads/2024/08/cropped-Logo-32x32.jpg')} sizes="32x32" />
    <link rel="apple-touch-icon" href={rel(R, '/uploads/2024/08/cropped-Logo-180x180.jpg')} />
    <link rel="sitemap" href={rel(R, '/sitemap-index.xml')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header transparent={transparentHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
