---
import Layout from '../layouts/Layout.astro';
import { rel } from '../lib/url';

const R = Astro.url.pathname;
---

<Layout title="Page introuvable">
  <div class="page-hero" style={`background-image: url('${rel(R, '/uploads/2024/08/103.jpg')}');`}>
    <h1>404</h1>
  </div>
  <section class="section text-center">
    <div class="container">
      <p style="font-size: 1.2rem;">Oups ! Cette page n'existe pas ou plus.</p>
      <p><a href={rel(R, '/')} class="btn">Retour à l'accueil</a></p>
    </div>
  </section>
</Layout>
