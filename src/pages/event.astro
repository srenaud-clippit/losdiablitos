---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { rel } from '../lib/url';

const R = Astro.url.pathname;

// Évènements à venir. Les évènements passés sont retirés de cette liste.
const events = [
  {
    date: 'Samedi 5 Septembre 2026',
    title: 'Forum des associations',
    paragraphs: [
      "Venez nous rencontrer au forum des associations, à la Salle des Fêtes de Thoiry. C'est l'occasion d'échanger avec nous, de poser toutes vos questions sur les cours de Salsa, Bachata et Kizomba… et de vous inscrire pour la saison 2026/2027.",
    ],
  },
];
---

<Layout title="Evènements">
  <div
    class="page-hero"
    style={`background-image: url('${rel(R, '/uploads/2024/08/Event3-scaled.jpg')}');`}
  >
    <h1>Evènements</h1>
  </div>

  <section class="section">
    <div class="container" style="max-width: 900px;">
      <p class="intro text-center">
        Voilà nos prochains rendez-vous… N'hésitez pas à nous solliciter via notre mail
        <a href={`mailto:${site.email}`}>{site.email}</a> ou via notre
        <a href={rel(R, '/nous-contacter/')}>page contact</a>.
      </p>

      <div class="events">
        {
          events.map((event) => (
            <article class="event-card">
              <div class="event-date">{event.date}</div>
              <div class="event-body prose">
                <h3>{event.title}</h3>
                {event.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro {
    font-size: 1.1rem;
    margin-bottom: 40px;
  }

  .events {
    display: grid;
    gap: 28px;
  }

  .event-card {
    display: grid;
    grid-template-columns: 200px 1fr;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 30px var(--shadow-primary);
  }

  .event-date {
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 28px 20px;
    line-height: 1.4;
  }

  .event-body {
    padding: 28px 32px;
  }

  .event-body h3 {
    margin-top: 0;
    color: var(--color-primary);
  }

  .event-body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .event-card {
      grid-template-columns: 1fr;
    }
    .event-date {
      padding: 16px;
    }
  }
</style>
