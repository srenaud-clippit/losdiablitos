---
import Layout from '../layouts/Layout.astro';
import { site, contacts } from '../data/site';
import { rel } from '../lib/url';

const R = Astro.url.pathname;
---

<Layout title="Nous contacter">
  <div
    class="page-hero"
    style={`background-image: url('${rel(R, '/uploads/2022/08/volunteers-hero.jpg')}');`}
  >
    <h1>Nous contacter</h1>
  </div>

  <section class="section">
    <div class="container" style="max-width: 900px;">
      <p class="intro">
        Vous joindre directement par téléphone
        {
          contacts.map((c, i) => (
            <>
              {i > 0 ? (i === contacts.length - 1 ? ' ou ' : ', ') : ' '}
              <strong>{c.name}</strong> (<a href={`tel:+33${c.phone.replace(/\s/g, '').slice(1)}`}>{c.phone}</a>)
            </>
          ))
        }.
      </p>
      <p class="intro">
        Cependant, n'hésitez pas à renvoyer votre demande en remplissant le formulaire ci-dessous et
        nous vous répondrons dès que possible et avec plaisir.
      </p>

      <div class="contact-grid">
        <div class="contact-cards">
          {
            contacts.map((c) => (
              <div class="contact-card">
                <span class="contact-name">{c.name}</span>
                <a href={`tel:+33${c.phone.replace(/\s/g, '').slice(1)}`}>{c.phone}</a>
              </div>
            ))
          }
          <div class="contact-card email-card">
            <span class="contact-name">E-mail</span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </div>
        </div>

        <form id="contact-form" class="contact-form">
          <label>
            Prénom &amp; Nom <span class="req">*</span>
            <input type="text" name="name" required />
          </label>
          <label>
            E-mail <span class="req">*</span>
            <input type="email" name="email" required />
          </label>
          <label>
            Commentaire ou message
            <textarea name="message" rows="6"></textarea>
          </label>
          <button type="submit" class="btn">Envoyer le message</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = data.get('name') || '';
    const from = data.get('email') || '';
    const message = data.get('message') || '';
    const subject = encodeURIComponent(`Contact site — ${name}`);
    const body = encodeURIComponent(`De : ${name} (${from})\n\n${message}`);
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>

<style>
  .intro {
    font-size: 1.05rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    margin-top: 36px;
    align-items: start;
  }

  .contact-cards {
    display: grid;
    gap: 12px;
  }

  .contact-card {
    background: var(--color-bg-alt);
    border-radius: 12px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    border-left: 4px solid var(--color-primary);
  }

  .contact-name {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .contact-card a {
    font-size: 1.1rem;
    font-weight: 500;
  }

  .contact-form {
    background: #fff;
    border-radius: 14px;
    padding: 32px;
    box-shadow: 0 8px 30px rgba(45, 143, 184, 0.1);
    display: grid;
    gap: 18px;
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .req {
    color: #e05252;
  }

  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 12px 14px;
    border: 1px solid #d7dee3;
    border-radius: 8px;
    background: #fff;
    color: var(--color-text);
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(110, 193, 228, 0.25);
  }

  .contact-form .btn {
    justify-self: start;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
